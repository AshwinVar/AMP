# Python
backend/.env
backend/venv/
backend/__pycache__/
backend/*.pyc
backend/*.db
backend/*.sqlite3

# Node
frontend/node_modules/
frontend/.next/
frontend/.env.local
frontend/.env

# OS
.DS_Store
Thumbs.db

# Python (general: ignore bytecode and virtualenvs anywhere)
__pycache__/
*.pyc
venv/
.venv/

# Orphan nested repo from commit 1 — untracked; delete the local dir at will.
FlowMES-Enterprise/

# Playwright writes these on every run
frontend/test-results/
frontend/playwright-report/
frontend/blob-report/

# Coverage artefacts. .coverage is a binary SQLite database of line hits — it is
# a measurement of one run on one machine, it changes on every run, and nothing
# reads it but the report command. htmlcov/ is the rendered version of it.
.coverage
.coverage.*
htmlcov/

# Vitest writes its HTML coverage report here. Same reasoning as htmlcov/: it is
# a rendering of one run on one machine.
frontend/coverage/

# conftest.py's fallback DATABASE_URL points here, so a bare `pytest` cannot
# scribble on a developer's real database. Throwaway by design.
backend/.pytest.db
