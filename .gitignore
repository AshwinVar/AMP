# Python
backend/.env
backend/venv/
backend/__pycache__/
backend/*.pyc
backend/*.db
backend/*.sqlite3

# Node
frontend/node_modules/
frontend/.next/
frontend/.env.local
frontend/.env

# OS
.DS_Store
Thumbs.db

# Python (general: ignore bytecode and virtualenvs anywhere)
__pycache__/
*.pyc
venv/
.venv/

# Orphan nested repo from commit 1 — untracked; delete the local dir at will.
FlowMES-Enterprise/

# Playwright writes these on every run
frontend/test-results/
frontend/playwright-report/
frontend/blob-report/

# Coverage artefacts. .coverage is a binary SQLite database of line hits — it is
# a measurement of one run on one machine, it changes on every run, and nothing
# reads it but the report command. htmlcov/ is the rendered version of it.
.coverage
.coverage.*
htmlcov/

# Vitest writes its HTML coverage report here. Same reasoning as htmlcov/: it is
# a rendering of one run on one machine.
frontend/coverage/

# conftest.py's fallback DATABASE_URL points here, so a bare `pytest` cannot
# scribble on a developer's real database. Throwaway by design.
backend/.pytest.db

# Load-test run artifacts (the results JSON IS committed; these are not)
backend/loadtest_server.log
backend/dr_drill.sql

# Claude Code session state. .claude/worktrees alone is ~15 MB of throwaway git
# worktrees from parallel agent runs, and it is regenerated on demand. Not
# ignoring it meant `git status` always showed it, one `git add -A` away from a
# 15 MB commit. settings.local.json is separately excluded by a global ignore;
# launch.json is a local dev-server config, not a project artifact.
.claude/

# A generated `tree /f` dump of the working directory: 1.6 MB, 37,720 lines, 145
# of them node_modules. Regenerate it rather than commit it.
tree.txt

# Rendered training deliverables. The MARKDOWN SOURCES are tracked and
# docs/build_training_pdf.py rebuilds these from them, so committing the
# renderings would store ~570 KB of binary that goes stale the moment a source
# changes. Note the rebuild is not byte-identical off Windows (the script
# registers C:/Windows/Fonts and falls back to Helvetica elsewhere), which is
# another reason the source is the artefact of record.
docs/training/*.pdf
docs/training/handbook.html
docs/*.pdf
docs/sales/*.pdf
