# Copy this file to .env and fill in your values

# PostgreSQL connection string
# Format: postgresql://user:password@host:port/dbname
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/flowmes_db

# JWT secret — generate with: openssl rand -hex 32
SECRET_KEY=replace_with_a_long_random_string

# CORS — comma-separated list of allowed frontend origins
# For Vercel deployments add your domain here
ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com

# MQTT broker (leave default for local broker; use cloud broker host for production)
MQTT_BROKER=127.0.0.1
MQTT_PORT=1883
# Telemetry topics are flowmes/<TENANT>/<SITE>/machines — the tenant is part of
# the topic so a broker ACL can enforce which customer a gateway may publish as.
# Use "-" for SITE when a customer has one plant. Ingest subscribes to
# flowmes/+/+/machines.
MQTT_TOPIC_PREFIX=flowmes
# BREAKING CHANGE, single-tenant deployments only: messages on the old untenanted
# flowmes/machines topic are DROPPED unless you name their owner here. Set it to
# the tenant_code that topic's gateways belong to, or move them to a tenant topic.
# Left blank, that topic is not even subscribed to.
MQTT_LEGACY_TENANT=
MQTT_LEGACY_SITE=
