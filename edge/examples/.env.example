# AMP Edge — environment template. NO VALUES ARE COMMITTED HERE.
#
# Copy to .env (or set these in the service's environment) and fill in. The
# gateway refuses to start if a name it needs is not set, rather than starting
# and failing to authenticate later.

# Issued by AMP, per gateway. Binds this gateway to ONE workspace and site:
# changing the tenant in the config does not let you publish as anyone else.
AMP_GATEWAY_KEY=

# The MQTT broker credentials AMP issued.
AMP_MQTT_USERNAME=
AMP_MQTT_PASSWORD=

# The PLC's own credentials, if it needs any. SEPARATE from the AMP ones on
# purpose: a plant's controls password must never be the thing that also grants
# access to their AMP workspace.
PLC_PASSWORD=
